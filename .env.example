# Local Docker Compose only. Change this before first start.
DATABASE_PASSWORD=replace-with-a-long-random-password
# Native production runtime uses JDBC format:
# DATABASE_URL=jdbc:postgresql://hostname:5432/global_talent_radar?sslmode=require
# DATABASE_USERNAME=your_database_user
# DATABASE_PASSWORD=your_database_password
# PORT=8080
# CORS_ORIGINS=https://your-frontend.example
